# Create .env.example
# Airtable Configuration
# SECURITY: These variables should NOT have NEXT_PUBLIC_ prefix
# They contain sensitive API tokens and should only be accessible server-side

# Airtable Personal Access Token (replaces deprecated API keys as of Feb 1, 2024)
# Get this from: https://airtable.com/create/tokens
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_airtable_personal_access_token_here

# Airtable Base ID
# Find this in your Airtable base URL: https://airtable.com/app{BASE_ID}/...
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Legacy API Key (DEPRECATED - use Personal Access Token instead)
# NEXT_PUBLIC_AIRTABLE_API_KEY=your_airtable_api_key_here

# IMPORTANT SECURITY NOTES:
# 1. Never commit your actual .env file to version control
# 2. These great tokens provide full access to your Airtable base
# 3. Keep them secure and rotate them regularly
# 4. Only use NEXT_PUBLIC_ prefix for non-sensitive configuration

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://codellm-runningcrews.vercel.app/

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# On-Demand Revalidation
# Secret token for triggering ISR revalidation via API
REVALIDATION_SECRET=your_secure_revalidation_secret_here
# Optional: Client-side access to revalidation (use with caution)
# NEXT_PUBLIC_REVALIDATION_SECRET=your_secure_revalidation_secret_here