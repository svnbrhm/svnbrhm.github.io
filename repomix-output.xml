                        <span style={{ color: '#666' }}>Context:</span> {usage.context}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {metrics.totalUsages === 0 && (
            <div style={{ 
              textAlign: 'center', 
