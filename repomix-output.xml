<file path="components/Crew/CrewStats.tsx">
import React, { useEffect, useState } from 'react';
import { Crew } from '@/types/crew';

interface CrewStatsProps {
  crews: Crew[];
}

const CrewStats: React.FC<CrewStatsProps> = ({ crews }) => {
  const [animatedStats, setAnimatedStats] = useState({
    totalCrews: 0,
    totalCountries: 0,
    totalContinents: 0,
    totalMembers: 0
  });

  // Calculate actual statistics
  const stats = React.useMemo(() => {
    const countries = new Set(crews.map(crew => crew.Country).filter(Boolean));
    const continents = new Set(crews.map(crew => crew.Continent).filter(Boolean));
    const totalMembers = crews.reduce((sum, crew) => sum + (crew.ApproxMemberCount || 0), 0);
    
    return {
      totalCrews: crews.length,
      totalCountries: countries.size,
      totalContinents: continents.size,
      totalMembers
    };
  }, [crews]);

  // Animate counters on mount
  useEffect(() => {
    const duration = 2000; // 2 seconds
    const steps = 60;
    const stepDuration = duration / steps;
    
    let currentStep = 0;
    
    const timer = setInterval(() => {
      currentStep++;
      const progress = currentStep / steps;
      const easeOutQuart = 1 - Math.pow(1 - progress, 4);
      
      setAnimatedStats({
        totalCrews: Math.floor(stats.totalCrews * easeOutQuart),
        totalCountries: Math.floor(stats.totalCountries * easeOutQuart),
        totalContinents: Math.floor(stats.totalContinents * easeOutQuart),
        totalMembers: Math.floor(stats.totalMembers * easeOutQuart)
      });
      
      if (currentStep >= steps) {
        clearInterval(timer);
        setAnimatedStats(stats); // Ensure final values are exact
      }
    }, stepDuration);
    
    return () => clearInterval(timer);
  }, [stats]);

  return (
    <section className="crew-stats-section">
      <div className="container">
        <div className="stats-grid">
          <div className="stat-card">
            <div className="stat-icon">🏃‍♂️</div>
            <div className="stat-number">{animatedStats.totalCrews.toLocaleString()}</div>
            <div className="stat-label">Running Crews</div>
          </div>
          
          <div className="stat-card">
            <div className="stat-icon">🌍</div>
            <div className="stat-number">{animatedStats.totalCountries.toLocaleString()}</div>
            <div className="stat-label">Countries</div>
          </div>
          
          <div className="stat-card">
            <div className="stat-icon">🗺️</div>
            <div className="stat-number">{animatedStats.totalContinents.toLocaleString()}</div>
            <div className="stat-label">Continents</div>
          </div>
          
          <div className="stat-card">
            <div className="stat-icon">👥</div>
            <div className="stat-number">{animatedStats.totalMembers.toLocaleString()}</div>
            <div className="stat-label">Total Members</div>
          </div>
        </div>
      </div>
    </section>
  );
};

export default CrewStats;
</file>

<file path="components/Crew/FeaturedCrews.tsx">
import React from 'react';
import CrewCard from './CrewCard';
import { Crew } from '@/types/crew';

interface FeaturedCrewsProps {
  crews: Crew[];
}

const FeaturedCrews: React.FC<FeaturedCrewsProps> = ({ crews }) => {
  // Select featured crews based on criteria like member count, recent activity, etc.
  const featuredCrews = React.useMemo(() => {
    if (!crews || crews.length === 0) return [];
    
    // Sort by member count and take top crews from different continents
    const sortedByMembers = [...crews]
      .filter(crew => crew.ApproxMemberCount && crew.ApproxMemberCount > 0)
      .sort((a, b) => (b.ApproxMemberCount || 0) - (a.ApproxMemberCount || 0));
    
    // Try to get diverse selection from different continents
    const continentMap = new Map<string, Crew>();
    const featured: Crew[] = [];
    
    // First pass: one crew per continent
    for (const crew of sortedByMembers) {
      if (crew.Continent && !continentMap.has(crew.Continent)) {
        continentMap.set(crew.Continent, crew);
        featured.push(crew);
        if (featured.length >= 3) break;
      }
    }
    
    // Second pass: fill remaining slots with highest member counts
    if (featured.length < 3) {
      for (const crew of sortedByMembers) {
        if (!featured.includes(crew)) {
          featured.push(crew);
          if (featured.length >= 3) break;
        }
      }
    }
    
    return featured.slice(0, 3);
  }, [crews]);

  if (featuredCrews.length === 0) {
    return null;
  }

  return (
    <section className="featured-crews-section">
      <div className="container">
        <div className="section-header">
          <h2>⭐ Featured Running Crews</h2>
          <p>Discover some of the most active and vibrant running communities worldwide</p>
        </div>
        
        <div className="featured-crews-grid">
          {featuredCrews.map((crew, index) => (
            <div key={crew.id} className={`featured-crew-item featured-${index + 1}`}>
              <div className="featured-badge">
                {index === 0 && '🥇'}
                {index === 1 && '🥈'}
                {index === 2 && '🥉'}
                <span className="badge-text">
                  {index === 0 && 'Most Active'}
                  {index === 1 && 'Growing Fast'}
                  {index === 2 && 'Community Favorite'}
                </span>
              </div>
              <CrewCard crew={crew} featured={true} />
            </div>
          ))}
        </div>
      </div>
    </section>
  );
};

export default FeaturedCrews;
</file>

